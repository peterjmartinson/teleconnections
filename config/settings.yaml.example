# Teleconnection Climatology Builder configuration — EXAMPLE FILE
# Copy to config/settings.yaml to customize.
database:
  path: ""

era5:
  provider: "open_meteo"
  history_start: "1979-01-01"
  history_end: ""
  finalization_lag_days: 5
  raw_cache_dir: "data/raw/era5"

indices:
  raw_cache_dir: "data/raw/indices"
  ao_url: "https://ftp.cpc.ncep.noaa.gov/cwlinks/norm.daily.ao.cdas.z1000.19500101_current.csv"
  nao_url: "https://ftp.cpc.ncep.noaa.gov/cwlinks/norm.daily.nao.cdas.z500.19500101_current.csv"
  pna_url: "https://ftp.cpc.ncep.noaa.gov/cwlinks/norm.daily.pna.cdas.z500.19500101_current.csv"
  nino34_url: "https://www.cpc.ncep.noaa.gov/data/indices/detrend.nino34.ascii.txt"
  mjo_bom_url: "http://www.bom.gov.au/clim_data/IDCKGEM000/rmm.74toRealtime.txt"
  mjo_psl_fallback_url: "https://psl.noaa.gov/mjo/mjoindex/romi.cpcolr.1x.txt"

analysis:
  climatology_window_days: 15
  mjo_active_amplitude: 1.0
  lag_windows:
    - [0, 5]
    - [6, 10]
    - [11, 15]
    - [16, 20]
